{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OFAST Studio",
  "version": "1.0.3",
  "identifier": "com.ofast.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OFAST Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwRjg0RDg4MUIyQzA5RUIKUldUckNTd2JpRTM0OFBBaU0rc3NHS3EzOW5CODZwaU1TaEE5NDVoWjY1TXNJUStJbjZCVW9YenQK",
      "endpoints": ["https://github.com/synk1337/OFAST/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "OFAST",
    "copyright": "MIT License, Synk1337 and the OFAST contributors",
    "shortDescription": "CS2 demos to Unreal Engine 5.8 scenes",
    "longDescription": "OFAST Studio: browse CS2 demos, find the highlights, send a round to Unreal Engine 5.8 with its map, players, weapons, skins, cameras and effects, and render it.",
    "resources": {
      "../../../tools/unreal/*.py": "tools/unreal/",
      "../../../unreal/Sandbox/OFASTSandbox.uproject": "project-template/OFASTSandbox.uproject",
      "../../../unreal/Sandbox/Config/*": "project-template/Config/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
